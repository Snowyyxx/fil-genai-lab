# Copy to backend/.env and edit. Every value is optional.

# --- AWS ---------------------------------------------------------------------
# boto3 resolves credentials from the normal chain. Easiest local options:
#   export AWS_PROFILE=my-profile          (uses ~/.aws/credentials)
#   export AWS_ACCESS_KEY_ID=... AWS_SECRET_ACCESS_KEY=...
AWS_REGION=us-east-1
# AWS_PROFILE=default

# --- Bedrock -----------------------------------------------------------------
# Leave unset to auto-pick the best OPEN-WEIGHT model enabled in your account
# (meta / mistral / deepseek / qwen / openai — see GET /ai/models).
# Pin it once you know which one you want, e.g.
# BEDROCK_MODEL_ID=us.meta.llama3-3-70b-instruct-v1:0
# BEDROCK_MODEL_ID=us.openai.gpt-oss-120b-1:0
# BEDROCK_MODEL_ID=mistral.mixtral-8x7b-instruct-v0:1
# Any Bedrock model works if pinned — the app talks the vendor-neutral Converse API.
# BEDROCK_MODEL_ID=
BEDROCK_MAX_TOKENS=3000

# --- App ---------------------------------------------------------------------
# 1 = never call Bedrock; the offline Zen cat answers everything.
MEOW_FORCE_MOCK=0
# MEOW_DATA_FILE=tasks.json
# MEOW_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5500
