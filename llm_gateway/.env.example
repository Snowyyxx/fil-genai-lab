# Copy to `.env` and edit. docker-compose reads it automatically.

# Shared secret between the FastAPI app and the LiteLLM proxy.
# Any string; requests to LiteLLM must send it as a Bearer token.
LITELLM_MASTER_KEY=sk-local-dev-key

# LangSmith tracing — get a key at https://smith.langchain.com
# (Settings → API Keys). Leave blank to disable tracing.
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=llm-gateway

# OpenAI key — required by the OpenAI Moderation guardrail
OPENAI_API_KEY=
